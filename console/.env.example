# A Supabase personal access token (supabase.com → Account → Access Tokens, or the
# token the Supabase CLI stored when you ran `supabase login`). One token reaches
# every company's project through the Management API.
SUPABASE_ACCESS_TOKEN=sbp_...

# Optional single-user gate. When set, open the console once with ?key=<value>.
CONSOLE_KEY=
